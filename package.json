{
  "name": "@kuldeep2822k/palee",
  "version": "1.0.0",
  "description": "A smart, AI-powered study tracker that optimizes learning with spaced repetition and dependency-aware recommendations.",
  "homepage": "https://kuldeep2822k.github.io/cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuldeep2822k/cli.git"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "palee": "./dist/bin/palee.js"
  },
  "files": [
    "dist/src",
    "dist/bin",
    "dist/package.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "build": "tsc && node -e \"require('fs').copyFileSync('package.json', 'dist/package.json')\"",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pretest": "npm run build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/storage-*.test.ts\" \"test/engine-*.test.ts\" \"test/types-*.test.ts\" \"test/smoke.test.ts\"",
    "pretest:fast": "npm run build",
    "test:fast": "node --import tsx --test \"test/cli-*.test.ts\" \"test/engine-*.test.ts\" \"test/fault-injection.test.ts\" \"test/property-fuzz.test.ts\" \"test/session-*.test.ts\" \"test/smoke.test.ts\" \"test/storage-*.test.ts\" \"test/stress-concurrency.test.ts\" \"test/timezone-matrix.test.ts\" \"test/types-*.test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --import tsx --test \"test/e2e/*.test.ts\"",
    "pretest:fuzz": "npm run build",
    "test:fuzz": "node --import tsx --test \"test/property-fuzz.test.ts\" \"test/stress-concurrency.test.ts\" \"test/challenger1-*.test.ts\"",
    "test:coverage": "node --max-old-space-size=4096 ./node_modules/c8/bin/c8.js npm test"
  },
  "keywords": [
    "spaced-repetition",
    "learning",
    "obsidian",
    "sm2",
    "study-tracker"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "c8": "^12.0.0",
    "diff-cover": "^2.0.5",
    "eslint": "^10.8.1",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.16.1",
    "tsx": "^4.23.11",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
